DATABASE_URL="postgresql://h1b:change-me-locally@localhost:5432/h1b_engine"
# Optional – enables distributed rate limiting. Without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated hostnames allowed to invoke Server Actions. Unset → localhost only.
# ALLOWED_ORIGINS=h1b.example.org,www.h1b.example.org
# Per-IP rate limit for the public /api/v1/* endpoints (defaults: 60 / "1 m").
# RATELIMIT_MAX=60
# RATELIMIT_WINDOW=1 m
